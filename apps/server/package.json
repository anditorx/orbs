{
  "name": "@orbs/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "node --env-file=../../.env ../../node_modules/vitest/vitest.mjs run integration",
    "dev:mock-asana": "tsx src/dev/mockAsana.ts",
    "dev:mock-gemini": "tsx src/dev/mockGemini.ts",
    "admin:promote": "tsx --env-file=../../.env src/cli/set-system-role.ts promote",
    "admin:demote": "tsx --env-file=../../.env src/cli/set-system-role.ts demote"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@orbs/db": "workspace:*",
    "@orbs/plugin-sdk": "workspace:*",
    "@orbs/protocol": "workspace:*",
    "@orpc/contract": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "better-auth": "^1.7.16",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  }
}
