# Copy to .env for local development.
DATABASE_URL=postgres://orbs:orbs@127.0.0.1:54329/orbs
# Public URL where the web app is served (used for auth redirects and CORS).
ORBS_WEB_URL=http://localhost:5173
# Server listen port.
ORBS_SERVER_PORT=8787
# Base URL of the API as seen by the browser.
BETTER_AUTH_URL=http://localhost:8787
# 32+ random bytes, e.g. `openssl rand -base64 32`. Signs sessions.
BETTER_AUTH_SECRET=change-me-in-production-please-32b
# Who may create accounts: open (dev default) | invite-only | domain.
# The first account on a fresh install is always allowed so an admin can bootstrap.
ORBS_SIGNUP_MODE=open
# Required when ORBS_SIGNUP_MODE=domain, comma-separated, e.g. company.co.id,subsidiary.com
ORBS_SIGNUP_DOMAINS=
# Where uploaded project files are stored (defaults to <repo>/.data in development).
# ORBS_DATA_DIR=/var/lib/orbs
# Upload limits for Code-mode projects.
ORBS_UPLOAD_MAX_FILE_MB=10
ORBS_PROJECT_MAX_MB=500
ORBS_PROJECT_MAX_FILES=20000

